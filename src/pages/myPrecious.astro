---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const resources = [
  {
    title: '前端工程化',
    description: 'Webpack、Sentry、Jest 等工程实践文章入口。',
    href: '/categories#%E5%89%8D%E7%AB%AF%E5%B7%A5%E7%A8%8B%E5%8C%96',
  },
  {
    title: 'React 笔记',
    description: 'React 18、Effect、Router 升级等框架记录。',
    href: '/categories#react',
  },
  {
    title: '语言基础',
    description: 'JavaScript、TypeScript、Node.js、Markdown 等基础整理。',
    href: '/categories#%E8%AF%AD%E8%A8%80',
  },
  {
    title: '踩坑复盘',
    description: '把真实问题写下来，下一次少花一点时间。',
    href: '/categories#%E8%B8%A9%E5%9D%91',
  },
];
---

<BaseLayout title={`百宝箱 | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <section class="page-hero">
    <div class="container">
      <p class="section-kicker">Toolbox</p>
      <h1>百宝箱</h1>
      <p>高频主题、工程实践和常用知识入口。</p>
    </div>
  </section>

  <section class="section">
    <div class="container post-grid">
      {resources.map((resource) => (
        <a href={resource.href} class="post-card">
          <div>
            <div class="post-meta">
              <span class="post-chip">Resource</span>
            </div>
            <h2 class="post-title">{resource.title}</h2>
            <p class="post-desc">{resource.description}</p>
          </div>
          <span class="post-link">查看入口</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
