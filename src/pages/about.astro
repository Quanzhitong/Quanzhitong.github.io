---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { postsByDate } from '../data/legacyPosts';
---

<BaseLayout title={`关于 | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <section class="page-hero">
    <div class="container split-panel">
      <div>
        <p class="section-kicker">About</p>
        <h1>本人</h1>
        <p>
          爱好的本质，是取悦自己。这个站点记录前端工程、学习笔记、踩坑复盘和一些生活里的观察。
        </p>
        <div class="button-row">
          <a class="button primary" href="/archives">看文章</a>
          <a class="button" href="https://github.com/Quanzhitong" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
      <aside class="profile-panel">
        <img class="profile-image" src="/images/xiao-durian.png" alt="修远头像" />
        <h2>修远</h2>
        <p>前端开发者。关注工程化、框架演进、自动化和个人知识管理。</p>
        <p>这里目前整理了 {postsByDate.length} 篇文章，记录工作、学习和生活里的具体问题。</p>
      </aside>
    </div>
  </section>
</BaseLayout>
