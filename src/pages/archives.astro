---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { groupPostsByYear, postsByDate } from '../data/legacyPosts';

const groups = groupPostsByYear();
const years = Object.keys(groups).sort((a, b) => b.localeCompare(a));
---

<BaseLayout title={`时光机 | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <section class="page-hero">
    <div class="container">
      <p class="section-kicker">Archive</p>
      <h1>时光机</h1>
      <p>按发布时间整理的文章归档，共 {postsByDate.length} 篇。</p>
    </div>
  </section>

  <section class="section">
    <div class="container timeline">
      {years.map((year) => (
        <div class="year-group">
          <div class="year-label">{year}</div>
          <div class="timeline-list">
            {groups[year].map((post) => (
              <a class="timeline-item" href={post.href}>
                <time class="timeline-date" datetime={post.date}>{post.date.slice(5)}</time>
                <span>
                  <strong>{post.title}</strong>
                  <br />
                  <span>{post.description}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
