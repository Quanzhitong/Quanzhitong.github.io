---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { allCategories, postsByDate } from '../../data/legacyPosts';
---

<BaseLayout title={`文章 | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <section class="page-hero">
    <div class="container">
      <p class="section-kicker">Posts</p>
      <h1>文章</h1>
      <p>这里先收拢旧站文章入口。旧文保持原地址可访问，新文章后续会直接进入 Astro 内容系统。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="archive-toolbar" data-post-filter>
        <label class="search-field">
          <span class="sr-only">搜索文章</span>
          <input type="search" placeholder="搜索标题、分类、标签" data-search-input />
        </label>
        <div class="filter-row" aria-label="按分类筛选">
          <button class="filter-chip active" type="button" data-filter-category="all" aria-pressed="true">全部</button>
          {allCategories.slice(0, 10).map((category) => (
            <button class="filter-chip" type="button" data-filter-category={category} aria-pressed="false">
              {category}
            </button>
          ))}
        </div>
        <p class="result-count" data-result-count>{postsByDate.length} 篇文章</p>
      </div>

      <div class="post-grid" data-post-grid>
        {postsByDate.map((post, index) => (
          <a
            href={post.href}
            class:list={['post-card', { featured: index === 0 }]}
            data-post-card
            data-title={post.title}
            data-categories={post.categories.join(' ')}
            data-tags={post.tags.join(' ')}
          >
            <div>
              <div class="post-meta">
                <time datetime={post.date}>{post.date}</time>
                <span class="post-chip">{post.categories[0]}</span>
              </div>
              <h2 class="post-title">{post.title}</h2>
              <p class="post-desc">{post.description}</p>
            </div>
            <span class="post-link">打开文章</span>
          </a>
        ))}
      </div>

      <div class="empty-state" data-empty-state hidden>
        <strong>没有匹配文章</strong>
        <p>换一个关键词或分类再试。</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const toolbar = document.querySelector<HTMLElement>('[data-post-filter]');
  const input = toolbar?.querySelector<HTMLInputElement>('[data-search-input]');
  const chips = Array.from(toolbar?.querySelectorAll<HTMLButtonElement>('[data-filter-category]') ?? []);
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-post-card]'));
  const resultCount = toolbar?.querySelector<HTMLElement>('[data-result-count]');
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
  let activeCategory = 'all';

  function applyFilter() {
    const keyword = input?.value.trim().toLowerCase() ?? '';
    let visibleCount = 0;

    cards.forEach((card) => {
      const searchable = [
        card.dataset.title,
        card.dataset.categories,
        card.dataset.tags,
      ].join(' ').toLowerCase();
      const categories = card.dataset.categories?.split(' ') ?? [];
      const matchesKeyword = !keyword || searchable.includes(keyword);
      const matchesCategory = activeCategory === 'all' || categories.includes(activeCategory);
      const isVisible = matchesKeyword && matchesCategory;

      card.classList.toggle('is-hidden', !isVisible);
      if (isVisible) visibleCount += 1;
    });

    if (resultCount) resultCount.textContent = `${visibleCount} 篇文章`;
    if (emptyState) emptyState.hidden = visibleCount > 0;
  }

  input?.addEventListener('input', applyFilter);

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeCategory = chip.dataset.filterCategory ?? 'all';
      chips.forEach((item) => {
        const isActive = item === chip;
        item.classList.toggle('active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });
      applyFilter();
    });
  });
</script>
