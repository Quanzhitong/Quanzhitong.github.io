---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPostsBySection } from '../data/legacyPosts';

const posts = getPostsBySection('tech');
---

<BaseLayout title={`有趣知识 | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <section class="page-hero">
    <div class="container">
      <p class="section-kicker">Tech Notes</p>
      <h1>有趣知识</h1>
      <p>前端基础、工程化、框架升级和踩坑复盘。这里是旧站技术文章的主入口。</p>
    </div>
  </section>

  <section class="section">
    <div class="container post-grid">
      {posts.map((post, index) => (
        <a href={post.href} class:list={['post-card', { featured: index === 0 }]}>
          <div>
            <div class="post-meta">
              <time datetime={post.date}>{post.date}</time>
              <span class="post-chip">{post.categories[0]}</span>
            </div>
            <h2 class="post-title">{post.title}</h2>
            <p class="post-desc">{post.description}</p>
          </div>
          <span class="post-link">打开文章</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
