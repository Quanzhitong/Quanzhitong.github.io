---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPostsBySection } from '../data/legacyPosts';

const posts = getPostsBySection('life');
---

<BaseLayout title={`生活 | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <section class="page-hero">
    <div class="container">
      <p class="section-kicker">Life</p>
      <h1>生活</h1>
      <p>技术之外的记录。暂时先接入旧站中明确归入生活/健康的内容。</p>
    </div>
  </section>

  <section class="section">
    <div class="container post-grid">
      {posts.map((post) => (
        <a href={post.href} class="post-card">
          <div>
            <div class="post-meta">
              <time datetime={post.date}>{post.date}</time>
              <span class="post-chip">{post.categories[0]}</span>
            </div>
            <h2 class="post-title">{post.title}</h2>
            <p class="post-desc">{post.description}</p>
          </div>
          <span class="post-link">打开文章</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
