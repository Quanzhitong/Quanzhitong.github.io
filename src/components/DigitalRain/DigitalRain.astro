---
interface Props {
  containerId: string;
}

const { containerId } = Astro.props;
---

<div id={containerId} class="digital-rain-container" data-digital-rain></div>

<script>
  const containers = document.querySelectorAll('[data-digital-rain]');

  containers.forEach((container) => {
    if (!(container instanceof HTMLElement)) return;

    const canvas = document.createElement('canvas');
    const context = canvas.getContext('2d');
    if (!context) return;

    container.appendChild(canvas);

    const chars = '嗡嘛呢呗咪吽';
    const fontSize = 22;
    const columnGap = 34;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let columns = 0;
    let streams = [];
    let animationFrame = 0;
    let previousTime = 0;
    let lastDrawTime = 0;

    const randomChar = () => chars[Math.floor(Math.random() * chars.length)];

    const createStream = (height) => {
      const length = 8 + Math.floor(Math.random() * 12);

      return {
        y: Math.random() * -height,
        speed: 46 + Math.random() * 34,
        length,
        symbols: Array.from({ length }, randomChar),
        nextChange: 120 + Math.random() * 260,
      };
    };

    const resize = () => {
      const rect = container.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.max(1, Math.floor(rect.width * dpr));
      canvas.height = Math.max(1, Math.floor(rect.height * dpr));
      canvas.style.width = `${rect.width}px`;
      canvas.style.height = `${rect.height}px`;
      context.setTransform(dpr, 0, 0, dpr, 0, 0);

      columns = Math.ceil(rect.width / columnGap);
      streams = Array.from({ length: columns }, () => createStream(rect.height || 360));
    };

    const draw = (time = 0) => {
      if (!reduceMotion && time - lastDrawTime < 24) {
        animationFrame = window.requestAnimationFrame(draw);
        return;
      }

      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      const delta = previousTime ? Math.min(time - previousTime, 48) : 16;
      previousTime = time;
      lastDrawTime = time;

      context.fillStyle = 'rgba(0, 0, 0, 0.42)';
      context.fillRect(0, 0, width, height);
      context.font = `600 ${fontSize}px "PingFang SC", "Microsoft YaHei", sans-serif`;
      context.textBaseline = 'top';

      streams.forEach((stream, index) => {
        const x = index * columnGap;
        const y = Math.round(stream.y);

        stream.nextChange -= delta;
        if (stream.nextChange <= 0) {
          stream.symbols = stream.symbols.map((symbol) => (Math.random() > 0.72 ? randomChar() : symbol));
          stream.nextChange = 120 + Math.random() * 300;
        }

        stream.symbols.forEach((symbol, symbolIndex) => {
          const symbolY = y - symbolIndex * fontSize;
          if (symbolY < -fontSize || symbolY > height + fontSize) return;

          const baseLightness = 1 - symbolIndex / stream.length;
          const lightnessMultiplier = symbolIndex < 3 ? 100 - symbolIndex * 5 : 50;
          const lightness = Math.max(10, baseLightness * lightnessMultiplier);
          context.fillStyle = `hsl(120 100% ${lightness}%)`;
          context.fillText(symbol, x, symbolY);
        });

        stream.y += stream.speed * (delta / 1000);
        if (stream.y - stream.length * fontSize > height + fontSize) {
          streams[index] = createStream(height);
          streams[index].y = -fontSize * (1 + Math.random() * 16);
        } else {
          streams[index] = stream;
        }
      });

      if (reduceMotion) return;
      animationFrame = window.requestAnimationFrame(draw);
    };

    resize();
    draw();

    const observer = new ResizeObserver(resize);
    observer.observe(container);

    window.addEventListener('beforeunload', () => {
      observer.disconnect();
      window.cancelAnimationFrame(animationFrame);
    });
  });
</script>

<style>
  .digital-rain-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .digital-rain-container canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
