---
import DigitalRain from './DigitalRain/DigitalRain.astro';

interface Props {
  postCount: number;
  categoryCount: number;
  latestTitle: string;
  latestHref: string;
}

const { postCount, categoryCount, latestTitle, latestHref } = Astro.props;
---

<section class="hero">
  <div class="hero-canvas">
    <DigitalRain containerId="digital-rain" />
  </div>
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <div class="hero-main">
      <p class="hero-eyebrow">Frontend / Notes / Personal Archive</p>
      <h1 class="hero-title">Hi, friend. I'm <span>XIUYUAN</span>.</h1>
      <p class="hero-subtitle">
        这里记录前端工程、踩坑复盘、读书和生活观察。日薅一毛无有尽，待到功成烤全羊。
      </p>
      <div class="button-row">
        <a class="button primary" href="/archives">浏览文章</a>
        <a class="button" href="/categories">按主题查看</a>
        <a class="button" href="/about">关于我</a>
      </div>
      <div class="hero-metrics" aria-label="站点统计">
        <div class="hero-metric">
          <strong>{postCount}</strong>
          <span>篇文章</span>
        </div>
        <div class="hero-metric">
          <strong>{categoryCount}</strong>
          <span>个主题分类</span>
        </div>
        <div class="hero-metric">
          <strong>2021</strong>
          <span>开始记录</span>
        </div>
      </div>
    </div>

    <aside class="hero-panel" aria-label="站点概览">
      <div class="hero-panel-row">
        <span>最新记录</span>
        <a href={latestHref}>{latestTitle}</a>
      </div>
      <div class="hero-panel-row">
        <span>文章索引</span>
        <strong>按时间与主题整理</strong>
      </div>
      <div class="hero-panel-row">
        <span>当前重点</span>
        <strong>前端工程化 / React / 读书笔记</strong>
      </div>
      <a class="hero-panel-link" href="/blog">进入完整文章库</a>
    </aside>
  </div>
</section>
